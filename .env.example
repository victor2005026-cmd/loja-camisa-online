# ---- Supabase ----
# Settings -> API no painel do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NUNCA exponha esta chave no frontend. Só é lida em rotas de API (server-side).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Admin ----
# E-mails (separados por vírgula) com acesso ao painel /admin. Use o mesmo
# e-mail da conta Google que você vai usar pra logar na loja.
ADMIN_EMAILS=seuemail@gmail.com

# ---- Notificação de pedido novo por e-mail ----
# Mesma API Key do Resend já usada no SMTP do Supabase (Authentication -> SMTP
# Settings -> Password). Sem essa variável, o checkout funciona normal, só não
# manda e-mail quando chega um pedido novo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Pix (chave própria, sem intermediador) ----
# Chave Pix que recebe os pagamentos (CPF, CNPJ, e-mail, telefone ou chave aleatória).
PIX_KEY=sua-chave-pix
# Nome exibido no QR Code pro cliente (até 25 caracteres).
PIX_MERCHANT_NAME=LV SPORTS
# Cidade exibida no QR Code (até 15 caracteres, sem acento).
PIX_MERCHANT_CITY=SANTOS

# ---- Mercado Pago (reservado pra quando for aceitar cartão) ----
# Não é usado hoje (pagamento é só Pix direto) — deixe como está até reativar.
# developers.mercadopago.com/panel -> sua aplicação -> Credenciais de teste
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_ENV=test

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
